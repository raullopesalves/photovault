    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/topojson-client": "^3.1.5",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.52.0",
    "playwright-core": "^1.63.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "topojson-client": "^3.1.0",
    "typescript": "5.9",
    "vite": "^7.3.7",
    "vitest": "^4.1.11",
    "world-atlas": "^2.0.2",
    "yazl": "^3.3.1"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.1",
    "electron-updater": "^6.8.9",
    "exifr": "^7.1.3",
    "ffmpeg-static": "^5.3.0",
    "heic-decode": "^2.1.0",
    "onnxruntime-node": "^1.30.0",
    "sharp": "^0.35.5",
    "yauzl": "^3.4.0"
  },
  "scripts": {
    "dev": "node scripts/electron-vite.mjs dev",
    "build": "node scripts/electron-vite.mjs build",
    "start": "node scripts/electron-vite.mjs preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node scripts/electron-vite.mjs build && node scripts/e2e-smoke.mjs",
    "dist": "node scripts/electron-vite.mjs build && electron-builder --win",
    "dist:dir": "node scripts/electron-vite.mjs build && electron-builder --win --dir",
    "test:e2e:packaged": "node scripts/electron-vite.mjs build && electron-builder --win --dir && node scripts/e2e-smoke.mjs --packaged",
    "test:perf": "node scripts/perf.mjs",
    "release": "node scripts/release.mjs"
  },
  "productName": "Photo Vault",
  "author": "Photo Vault"
